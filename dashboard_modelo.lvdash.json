{
  "datasets": [
    {
      "name": "f1c55b95",
      "displayName": "kpis_lgbm",
      "queryLines": [
        "-- dataset: kpis_lgbm\r\n",
        "SELECT round(auc,3) AS auc, round(gini,3) AS gini, round(ks,3) AS ks\r\n",
        "FROM workspace.credit_risk.model_metrics WHERE split='test' AND modelo='lgbm'"
      ]
    },
    {
      "name": "77561807",
      "displayName": "metricas_test",
      "queryLines": [
        "-- dataset: metricas_test\r\n",
        "SELECT modelo, round(gini,4) AS gini, round(gini_ic_inf,4) AS ic_inf, round(gini_ic_sup,4) AS ic_sup,\r\n",
        "       round(ks,4) AS ks, round(brier,4) AS brier\r\n",
        "FROM workspace.credit_risk.model_metrics WHERE split='test'"
      ]
    },
    {
      "name": "d1908ddf",
      "displayName": "deciles_lgbm",
      "queryLines": [
        "-- dataset: deciles_lgbm\r\n",
        "SELECT decil, n, defaults, round(tasa_real*100,2) AS default_real_pct, round(pd_media*100,2) AS pd_media_pct,\r\n",
        "       round(lift,2) AS lift, round(pct_defaults_acum*100,1) AS defaults_capturados_pct\r\n",
        "FROM workspace.credit_risk.model_deciles WHERE modelo='lgbm' AND split='test' ORDER BY decil\r\n"
      ]
    },
    {
      "name": "3b55958b",
      "displayName": "importancia",
      "queryLines": [
        "-- dataset: importancia\r\n",
        "SELECT variable, round(pct*100,2) AS importancia_pct\r\n",
        "FROM workspace.credit_risk.feature_importance ORDER BY pct DESC LIMIT 15"
      ]
    },
    {
      "name": "507d17e2",
      "displayName": "seg_educacion",
      "queryLines": [
        "-- dataset: seg_educacion   (repite cambiando NAME_EDUCATION_TYPE por NAME_INCOME_TYPE -> seg_ingreso)\r\n",
        "SELECT f.NAME_EDUCATION_TYPE AS segmento, count(*) AS clientes,\r\n",
        "       round(avg(f.TARGET)*100,2) AS default_real_pct, round(avg(s.score_lgbm)*100,2) AS pd_media_pct\r\n",
        "FROM workspace.credit_risk.gold_features f JOIN workspace.credit_risk.gold_scores s ON f.SK_ID_CURR = s.SK_ID_CURR\r\n",
        "WHERE f.split='test' GROUP BY 1 HAVING count(*) >= 200 ORDER BY 2 DESC\r\n"
      ]
    },
    {
      "name": "3d9429bb",
      "displayName": "seg_ingreso",
      "queryLines": [
        "-- dataset: seg_ingreso \r\n",
        "SELECT f.NAME_INCOME_TYPE AS segmento, count(*) AS clientes,\r\n",
        "       round(avg(f.TARGET)*100,2) AS default_real_pct, round(avg(s.score_lgbm)*100,2) AS pd_media_pct\r\n",
        "FROM workspace.credit_risk.gold_features f JOIN workspace.credit_risk.gold_scores s ON f.SK_ID_CURR = s.SK_ID_CURR\r\n",
        "WHERE f.split='test' GROUP BY 1 HAVING count(*) >= 200 ORDER BY 2 DESC"
      ]
    },
    {
      "name": "880600db",
      "displayName": "bandas",
      "queryLines": [
        "-- dataset: bandas\r\n",
        "SELECT CASE WHEN score_lgbm < 0.05 THEN '1 Bajo (<5%)' WHEN score_lgbm < 0.15 THEN '2 Medio (5-15%)'\r\n",
        "            ELSE '3 Alto (>=15%)' END AS banda,\r\n",
        "       count(*) AS clientes, round(avg(TARGET)*100,2) AS default_real_pct, round(avg(score_lgbm)*100,2) AS pd_media_pct\r\n",
        "FROM workspace.credit_risk.gold_scores WHERE split='test' GROUP BY 1 ORDER BY 1"
      ]
    },
    {
      "name": "7bc908af",
      "displayName": "deciles_fmt",
      "queryLines": [
        "-- dataset: deciles_fmt\r\n",
        "SELECT decil,\r\n",
        "       decil * 10                         AS pct_clientes,\r\n",
        "       round(tasa_real * 100, 2)          AS `Default real (%)`,\r\n",
        "       round(pd_media * 100, 2)           AS `PD predicha (%)`,\r\n",
        "       round(pct_defaults_acum * 100, 1)  AS `Defaults capturados (%)`\r\n",
        "FROM workspace.credit_risk.model_deciles\r\n",
        "WHERE modelo = 'lgbm' AND split = 'test'\r\n",
        "ORDER BY decil"
      ]
    },
    {
      "name": "afbb5be6",
      "displayName": "comparacion_modelos",
      "queryLines": [
        "-- dataset: comparacion_modelos\r\n",
        "SELECT CASE modelo WHEN 'lgbm' THEN 'LightGBM' WHEN 'xgb' THEN 'XGBoost' ELSE 'Scorecard WoE' END AS Modelo,\r\n",
        "       concat(format_number(gini,3), '  [', format_number(gini_ic_inf,3), ' – ', format_number(gini_ic_sup,3), ']') AS `Gini (IC 95%)`,\r\n",
        "       format_number(auc,3)   AS AUC,\r\n",
        "       format_number(ks,3)    AS KS,\r\n",
        "       format_number(brier,4) AS Brier\r\n",
        "FROM workspace.credit_risk.model_metrics\r\n",
        "WHERE split = 'test'\r\n",
        "ORDER BY gini DESC"
      ]
    },
    {
      "name": "5eca997b",
      "displayName": "kpis_portafolio",
      "queryLines": [
        "-- dataset: kpis_portafolio\r\n",
        "SELECT count(*) AS clientes,\r\n",
        "       round(avg(TARGET) * 100, 2)      AS default_real,\r\n",
        "       round(avg(score_lgbm) * 100, 2)  AS pd_media\r\n",
        "FROM workspace.credit_risk.gold_scores\r\n",
        "WHERE split = 'test'"
      ]
    },
    {
      "name": "d9ea5ba7",
      "displayName": "bandas_riesgo",
      "queryLines": [
        "-- dataset: bandas_riesgo\r\n",
        "SELECT CASE WHEN score_lgbm < 0.05 THEN 'A · <5%'\r\n",
        "            WHEN score_lgbm < 0.10 THEN 'B · 5–10%'\r\n",
        "            WHEN score_lgbm < 0.20 THEN 'C · 10–20%'\r\n",
        "            ELSE 'D · ≥20%' END                            AS Banda,\r\n",
        "       count(*)                                            AS Clientes,\r\n",
        "       round(100.0 * count(*) / sum(count(*)) OVER (), 1)  AS `% de la cartera`,\r\n",
        "       round(avg(TARGET) * 100, 2)                         AS `Default real (%)`,\r\n",
        "       round(avg(score_lgbm) * 100, 2)                     AS `PD predicha (%)`\r\n",
        "FROM workspace.credit_risk.gold_scores\r\n",
        "WHERE split = 'test'\r\n",
        "GROUP BY 1\r\n",
        "ORDER BY 1"
      ]
    },
    {
      "name": "881d8693",
      "displayName": "seg_educacion",
      "queryLines": [
        "-- dataset: seg_educacion\r\n",
        "SELECT CASE f.NAME_EDUCATION_TYPE\r\n",
        "         WHEN 'Higher education' THEN 'Superior'\r\n",
        "         WHEN 'Secondary / secondary special' THEN 'Secundaria'\r\n",
        "         WHEN 'Incomplete higher' THEN 'Superior incompleta'\r\n",
        "         WHEN 'Lower secondary' THEN 'Secundaria baja'\r\n",
        "         ELSE f.NAME_EDUCATION_TYPE END        AS Segmento,\r\n",
        "       count(*)                                AS Clientes,\r\n",
        "       round(avg(f.TARGET) * 100, 2)           AS `Default real (%)`,\r\n",
        "       round(avg(s.score_lgbm) * 100, 2)       AS `PD predicha (%)`\r\n",
        "FROM workspace.credit_risk.gold_features f\r\n",
        "JOIN workspace.credit_risk.gold_scores s ON f.SK_ID_CURR = s.SK_ID_CURR\r\n",
        "WHERE f.split = 'test'\r\n",
        "GROUP BY 1\r\n",
        "HAVING count(*) >= 200\r\n",
        "ORDER BY `Default real (%)` DESC"
      ]
    },
    {
      "name": "78a69d9a",
      "displayName": "seg_ingreso",
      "queryLines": [
        "-- dataset: seg_ingreso\r\n",
        "SELECT CASE f.NAME_INCOME_TYPE\r\n",
        "         WHEN 'Working' THEN 'Dependiente'\r\n",
        "         WHEN 'Commercial associate' THEN 'Socio comercial'\r\n",
        "         WHEN 'Pensioner' THEN 'Pensionista'\r\n",
        "         WHEN 'State servant' THEN 'Servidor público'\r\n",
        "         ELSE f.NAME_INCOME_TYPE END           AS Segmento,\r\n",
        "       count(*)                                AS Clientes,\r\n",
        "       round(avg(f.TARGET) * 100, 2)           AS `Default real (%)`,\r\n",
        "       round(avg(s.score_lgbm) * 100, 2)       AS `PD predicha (%)`\r\n",
        "FROM workspace.credit_risk.gold_features f\r\n",
        "JOIN workspace.credit_risk.gold_scores s ON f.SK_ID_CURR = s.SK_ID_CURR\r\n",
        "WHERE f.split = 'test'\r\n",
        "GROUP BY 1\r\n",
        "HAVING count(*) >= 200\r\n",
        "ORDER BY `Default real (%)` DESC"
      ]
    }
  ],
